{
  "name": "et-transactional-advisor-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
